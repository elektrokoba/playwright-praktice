    await expect(page.locator('.cart_item')).toHaveCount(2);
    await expect(page.locator('.shopping_cart_badge')).toHaveText('2');
    await expect(page.locator('.cart_item')).toContainText('Sauce Labs Backpack');
    await expect(page.locator('.cart_item')).toContainText('Sauce Labs Bolt T-Shirt');
});

// Test 3: Sorting dropdown - verify four sort methods
test('user can sort items by name and price in all four ways', async ({ page }: { page: Page }) => {
    const nameLocator = '.inventory_item_name';
    const priceLocator = '.inventory_item_price';
    const sortSelect = '.product_sort_container';

    // Helper to get names and prices
    const getNames = async () => await page.locator(nameLocator).allTextContents();
    const getPrices = async () => {
        const texts = await page.locator(priceLocator).allTextContents();
        return texts.map(t => parseFloat(t.replace('$', '').trim()));
    };

    // 1) Name (A to Z)
    await page.selectOption(sortSelect, 'az');
    const namesAZ = await getNames();
    const sortedAZ = [...namesAZ].sort((a, b) => a.localeCompare(b));
    expect(namesAZ).toEqual(sortedAZ);

    // 2) Name (Z to A)
    await page.selectOption(sortSelect, 'za');
    const namesZA = await getNames();
    const sortedZA = [...namesAZ].sort((a, b) => b.localeCompare(a));
    expect(namesZA).toEqual(sortedZA);

    // 3) Price (low to high)
    await page.selectOption(sortSelect, 'lohi');
    const pricesLoHi = await getPrices();
    const sortedLoHi = [...pricesLoHi].sort((a, b) => a - b);
    expect(pricesLoHi).toEqual(sortedLoHi);

    // 4) Price (high to low)
    await page.selectOption(sortSelect, 'hilo');
    const pricesHiLo = await getPrices();
    const sortedHiLo = [...pricesLoHi].sort((a, b) => b - a);
    expect(pricesHiLo).toEqual(sortedHiLo);
});

// New Tests: Affiliate Links feature
test('affiliate link sets affiliate_tracking cookie with 30-day expiry and shows banner + sends on order', async ({ page }: { page: Page }) => {
    const AFF_ID = 'QA_INFLUENCER';

    // Navigate with ref param (after beforeEach login this still sets the cookie)
    await page.goto(`https://www.saucedemo.com/?ref=${AFF_ID}`);

    // Verify cookie is set with correct name/value and ~30 day expiry
    const context = page.context();
    const cookies = await context.cookies('https://www.saucedemo.com/');
    const affCookie = cookies.find(c => c.name === 'affiliate_tracking');
    expect(affCookie).toBeTruthy();
    expect(affCookie?.value).toBe(AFF_ID);

    const nowSec = Math.floor(Date.now() / 1000);
    const thirtyDaysSec = 30 * 24 * 60 * 60;
    // allow small leeway (±120s)
    expect(affCookie!.expires).toBeGreaterThanOrEqual(nowSec + thirtyDaysSec - 120);
    expect(affCookie!.expires).toBeLessThanOrEqual(nowSec + thirtyDaysSec + 120);

    // Intercept outgoing POST requests to confirm affiliate data is sent (via Cookie header or request body)
    let affiliateObserved = false;
    page.on('request', req => {
        if (req.method() !== 'POST') return;
        const headers = req.headers();
        const cookieHeader = headers['cookie'] ?? headers['Cookie'] ?? '';
        const postData = req.postData() ?? '';
        if (cookieHeader.includes(`affiliate_tracking=${AFF_ID}`) || postData.includes(AFF_ID)) {
            affiliateObserved = true;
        }
    });

    // Add item and proceed to checkout overview
    await page.click('[data-test="add-to-cart-sauce-labs-backpack"]');
    await page.click('.shopping_cart_link');
    await expect(page).toHaveURL(/cart.html/);
    await page.click('[data-test="checkout"]');
    await expect(page).toHaveURL(/checkout-step-one.html/);
    await page.fill('#first-name', 'Aff');
    await page.fill('#last-name', 'Tester');
    await page.fill('#postal-code', '00000');
    await page.click('[data-test="continue"]');

    // On overview page verify banner showing referral applied (accept presence containing the AFF_ID)
    const banner = page.locator('.affiliate-banner');
    await expect(banner).toHaveText(new RegExp(`Referral applied:.*${AFF_ID}`));

    // Finish purchase and wait for network activity to settle
    await page.click('[data-test="finish"]');
    await page.waitForLoadState('networkidle');

    // Assert that at least one outgoing POST included affiliate info
    expect(affiliateObserved).toBeTruthy();
});